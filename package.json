{
  "name": "dsh-cache-diagnostics",
  "version": "0.1.1",
  "description": "DeepSeek Harness 插件：读会话日志做前缀归因的缓存诊断——按请求给出命中率、系统/工具变化、缓存前缀首差与判定；左栏图标 + 主面板整页。",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src",
    "scripts",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf lib && tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=lib/index.js \"--external:@deepseek-ai/*\" --external:react --external:react/jsx-runtime && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:latest": "pnpm pack",
    "test": "esbuild test/rows.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rows.test.mjs && node node_modules/.cache/rows.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.1-rc.3 <0.3.0-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.3",
    "@types/react": "^18.2.0",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "author": "Kiru-Sama",
  "license": "MIT",
  "keywords": "dsh,dsh-plugin,deepseek-harness,prompt-cache,cache-hit,cache-diagnostics,diagnostics"
}
